# ====================================
# Multi-Account Configuration
# ====================================
# Format: TOKEN_N dan CHANNEL_N (N = nomor akun, mulai dari 1)
# Setiap akun akan join ke 1 voice channel masing-masing

# Akun 1
TOKEN_1=token_discord_pertama
CHANNEL_1=id_voice_channel_pertama

# Akun 2
TOKEN_2=token_discord_kedua
CHANNEL_2=id_voice_channel_kedua

# Akun 3 (tambahkan sesuai kebutuhan)
# TOKEN_3=token_discord_ketiga
# CHANNEL_3=id_voice_channel_ketiga

# ====================================
# ATAU format lama (single akun)
# ====================================
# TOKEN=token_discord_kamu
# VOICE_CHANNEL_ID=id_voice_channel
